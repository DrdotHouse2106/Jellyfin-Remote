{
  "name": "jellyfin-remote",
  "version": "1.0.0",
  "private": true,
  "description": "Fernbedienung und Mediathek-Browser für Jellyfin – als PWA und native iOS-App (Capacitor).",
  "scripts": {
    "serve": "http-server app -p 8080 -c-1",
    "ios:add": "npx cap add ios && npm run ios:configure && npm run ios:assets",
    "ios:configure": "node scripts/ios-configure.mjs",
    "ios:assets": "capacitor-assets generate --ios --assetPath resources --iconBackgroundColor '#0b0d12' --splashBackgroundColor '#0b0d12'",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "plugin:build": "dotnet publish plugin/Jellyfin.Plugin.Remote -c Release -o plugin/dist"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/app": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "^7.0.0",
    "http-server": "14.1.1"
  }
}
