{
  "name": "jellyfin-remote",
  "version": "1.0.0",
  "private": true,
  "description": "Fernbedienung und Mediathek-Browser für Jellyfin – als PWA und native iOS-App (Capacitor).",
  "scripts": {
    "serve": "npx --yes http-server app -p 8080 -c-1",
    "ios:add": "npx cap add ios && npm run ios:assets",
    "ios:assets": "npx --yes @capacitor/assets generate --ios --assetPath resources --iconBackgroundColor '#0b0d12' --splashBackgroundColor '#0b0d12'",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
